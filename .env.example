# Opcional. Se ficar vazio, a aplicação gera e guarda um segredo em data/auth-secret.
# Use pelo menos 32 caracteres. Não compartilhe este valor.
AUTH_SECRET=

# Em desenvolvimento, a recuperação de senha mostra o link na tela porque não há servidor de e-mail.
# Em produção o link nunca é exibido. Defina false para esconder também no ambiente local.
EXPOSE_RESET_LINK=true

# Opcional. Os dois valores ligam o botão "Entrar com o Google".
# No Google Cloud, autorize este URI de redirecionamento:
# http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Só ligue se a aplicação estiver atrás de um proxy reverso que você controla.
# Com TRUST_PROXY=1, o IP usado é o último valor de X-Forwarded-For.
# Sem isso, cabeçalhos enviados pelo cliente são ignorados.
TRUST_PROXY=
